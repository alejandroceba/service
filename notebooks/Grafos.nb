Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Detectar", " ", "comunidades"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"comunidades", "=", 
     RowBox[{"FindGraphCommunities", "[", 
      RowBox[{"grafo", ",", 
       RowBox[{"Method", "->", "\"\<Modularity\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Colores", " ", "para", " ", "cada", " ", "comunidad"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colores", "=", 
     RowBox[{
      RowBox[{"ColorData", "[", "97", "]"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "comunidades", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Dibujar", " ", "grafo", " ", "resaltando", " ", "comunidades"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grafoComunidades", "=", 
     RowBox[{"HighlightGraph", "[", 
      RowBox[{"grafo", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"comunidades", ",", "colores"}], "}"}]}], "]"}], ",", 
       RowBox[{"VertexLabels", "->", "\"\<Name\>\""}], ",", 
       RowBox[{"EdgeLabels", "->", 
        RowBox[{"Thread", "[", 
         RowBox[{"aristas", "->", "pesos"}], "]"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"GraphLayout", "->", "\"\<LayeredEmbedding\>\""}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "grafoComunidades"}]}]], "Input",
 CellChangeTimes->{{3.988813558097863*^9, 3.988813578998404*^9}},
